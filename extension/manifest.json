{
  "manifest_version": 3,
  "name": "MDownloader",
  "version": "0.2.37",
  "default_locale": "en",
  "description": "__MSG_extension_description__",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "sidePanel", "clipboardWrite", "webRequest", "offscreen", "declarativeNetRequestWithHostAccess"],
  "optional_permissions": ["nativeMessaging", "downloads.open", "notifications"],
  "host_permissions": ["https://xszcdn11.com/*", "https://v1.xsz2-cdn.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/app-media-16.png",
    "32": "icons/app-media-32.png",
    "48": "icons/app-media-48.png",
    "128": "icons/app-media-128.png"
  },
  "action": {
    "default_title": "__MSG_action_title__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/app-media-16.png",
      "24": "icons/app-media-24.png",
      "32": "icons/app-media-32.png",
      "48": "icons/app-media-48.png"
    }
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "devtools_page": "devtools.html",
  "side_panel": { "default_path": "sidepanel.html" },
  "sandbox": { "pages": ["features/youtube/evaluator-sandbox.html"] },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' blob:; worker-src blob:; connect-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
