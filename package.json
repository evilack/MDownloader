{
  "name": "mdownloader-development-tools",
  "version": "0.2.45",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --expose-internals tools/checks/verify-project.mjs",
    "check:locales": "node tools/checks/audit-localization.mjs",
    "build:youtube": "node tools/build/build-youtube.mjs",
    "package:development": "node tools/build/package-extension.mjs --flavor development",
    "package:store": "node tools/build/package-extension.mjs --flavor chrome-store",
    "build:chrome": "node tools/build/package-extension.mjs --flavor chrome-store",
    "build:edge": "node tools/build/package-extension.mjs --flavor chrome-store",
    "build:development": "node tools/build/package-extension.mjs --flavor development",
    "build:all": "node tools/build/build-distributions.mjs"
  },
  "dependencies": {
    "googlevideo": "5.0.1",
    "youtubei.js": "18.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
